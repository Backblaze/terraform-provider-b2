root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.go]
indent_style = tab

[{GNUmakefile,Makefile,go.mod}]
indent_style = tab

[*.py]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,tf}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
