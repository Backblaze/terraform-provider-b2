#!/usr/bin/env bash
# CONFORMANCE CHECK -- terraform-provider-b2 x bucket.lifecycle
#
# Contract: bin/conformance/README.md (frozen).
# Reference implementation: bin/conformance/b2-sdk-python/files.upload.
#
# SHAPE. A Terraform provider exposes no callable API. Its customer path is
# `terraform apply` of a resource, a read-back, then `terraform destroy`. This
# file wraps that round trip so it still emits exactly ONE contract result line.
#
# Scenario (approved 2026-09-22):
#   Action  set daysFromHidingToDeleting: 1, read it back
#   Assert  equality
#
# ONE rule only. The provider carries orderLifecycleRules() precisely because
# B2 does not guarantee rule order; a single rule keeps this check testing the
# capability rather than that drift-suppression helper.
#
# EXPECTED VALUES -- B2's published contract, reviewed 2026-09-23.
# daysFromHidingToDeleting and fileNamePrefix are documented rule fields; B2's
# own example rule is daysFromHidingToDeleting 1 with daysFromUploadingToHiding
# null. "Unspecified properties are treated as having a null value", which is the
# expected value for every field not set here. b2_update_bucket lifecycleRules:
# "If specified, the existing lifecycle rules will be replaced with this new
# list."
# https://www.backblaze.com/docs/cloud-storage-lifecycle-rules
# https://www.backblaze.com/apidocs/b2-update-bucket
# The provider documents lifecycle_rules.file_name_prefix and
# days_from_hiding_to_deleting on the resource and the data source.
# https://registry.terraform.io/providers/Backblaze/b2/latest/docs/resources/bucket
# https://registry.terraform.io/providers/Backblaze/b2/latest/docs/data-sources/bucket
#
# It exercises the provider built from this exact checkout. Terraform still names
# `source = "Backblaze/b2"`, while the repository contract installs a `dev_overrides`
# entry for the exact-revision binary. Schema expectations come from the provider's
# own docs and the reviewed B2 API contract.
#
# TF_ACC=1 gates the provider's OWN Go acceptance suite, which lives in this repository. This check never runs it: it drives the terraform CLI against the
# exact-revision provider binary, so TF_ACC has no bearing here.
# REALM. The provider block's `endpoint` attribute (default B2_ENDPOINT) is
# passed to the embedded b2sdk's authorize_account as its realm
# (docs/sdks/terraform-provider-b2/card.md, "Auth model"), and b2sdk uses a
# value it does not recognise verbatim as the realm URL. Only the simulator is
# allowed: CONFORMANCE_SIMULATOR_URL, the harness's own server
# (bin/simulator/serve.mjs), with its fixed test credential; there is no
# staging or production mode. Plain http:// is enough: the provider also
# accepts the http upload and download URLs that realm mints.
set -uo pipefail
case "$-" in *x*) set +x ;; esac   # trace guard -- a credential must never be echoed

SLUG="terraform-provider-b2"
CAPABILITY="bucket.lifecycle"
TARGET="${CONFORMANCE_TARGET:-simulator}"

VERDICT="FAIL (harness -- the check ended without a verdict)"
EXIT_CODE=1
WORK=""
APPLIED=0
CONF_EXTRA_SECRET=""   # a secret this check mints itself, scrubbed from every line

note() { printf 'NOTE %s %s: %s\n' "$SLUG" "$CAPABILITY" "$1"; }

# Every line that leaves this process passes through here. <detail> carries an
# error class, never a response body and never a key.
redact() {
  local s
  s="$(cat)"
  [ -n "${B2_APPLICATION_KEY_ID:-}" ] && s="${s//${B2_APPLICATION_KEY_ID}/[redacted]}"
  [ -n "${B2_APPLICATION_KEY:-}" ] && s="${s//${B2_APPLICATION_KEY}/[redacted]}"
  [ -n "${CONF_EXTRA_SECRET:-}" ] && s="${s//${CONF_EXTRA_SECRET}/[redacted]}"
  printf '%s' "$s" | sed -e 's/[Aa]uthorization=[^ "&]*/Authorization=[redacted]/g'
}

first_error() { # <file> -> one sanitised line
  local line
  # The b2 provider re-raises b2sdk's exceptions through a Python traceback, so
  # the useful line is the dotted exception class at the END, not the
  # "Error: Traceback (most recent call last):" at the start.
  line="$(grep -m1 -E '^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z0-9_]+)+: ' "$1" 2>/dev/null | tr -d '\r\t')"
  [ -n "$line" ] || line="$(grep -E '^Error: ' "$1" 2>/dev/null | grep -v -i 'traceback' | head -1 | tr -d '\r\t')"
  [ -n "$line" ] || line="$(grep -m1 -i 'error' "$1" 2>/dev/null | tr -d '\r\t')"
  [ -n "$line" ] || line="terraform exited non-zero with no Error line"
  printf '%s' "$line" | redact | cut -c1-140
}

# Cleanup runs on every path, including the error path: a failed run that
# leaves a bucket standing is a leak, not a result. Stage 99 is the destroy
# stage -- every resource present, every data source gone.
finish() {
  if [ "$APPLIED" = 1 ] && [ -n "$WORK" ]; then
    if ! TF_VAR_stage=99 terraform -chdir="$WORK" destroy -auto-approve \
         -input=false -no-color >"$WORK/destroy.out" 2>&1; then
      if [ "$VERDICT" = "PASS" ]; then
        VERDICT="FAIL (cleanup -- terraform destroy left resources behind: $(first_error "$WORK/destroy.out"))"
        EXIT_CODE=1
      fi
    fi
  fi
  [ -n "$WORK" ] && rm -rf "$WORK"
  printf 'CONFORMANCE %s %s @%s: %s\n' "$SLUG" "$CAPABILITY" "$TARGET" "$VERDICT"
  exit "$EXIT_CODE"
}
trap finish EXIT

amber() { VERDICT="COULD-NOT-RUN ($1 -- $2)"; EXIT_CODE=0; exit 0; }
fail()  { VERDICT="FAIL ($1 -- $2)"; EXIT_CODE=1; exit 1; }
pass()  { VERDICT="PASS"; EXIT_CODE=0; exit 0; }

need() { command -v "$1" >/dev/null 2>&1; }

sha1_of() {
  if need sha1sum; then sha1sum "$1" | cut -d' ' -f1
  elif need shasum; then shasum -a 1 "$1" | cut -d' ' -f1
  elif need openssl; then openssl dgst -sha1 "$1" | awk '{print $NF}'
  else return 1
  fi
}

rand_hex() {
  if need openssl; then openssl rand -hex 6
  else LC_ALL=C tr -dc 'a-f0-9' < /dev/urandom 2>/dev/null | head -c 12
  fi
}

tf() { terraform -chdir="$WORK" "$@" >"$WORK/last.out" 2>&1; }

# Classify a failed terraform step. Every failure is a FAIL; the category only
# names what failed. The b2 provider makes
# no B2 call of its own -- it shells out to an embedded b2sdk and re-raises that
# exception through a Python traceback -- so what is matched here is b2sdk's
# exception CLASSES and codes, never an HTTP status line the provider never
# prints. Verified against a live `terraform apply` on 2026-09-22.
tf_trouble() { # <step>
  local txt
  txt="$(LC_ALL=C tr '[:upper:]' '[:lower:]' <"$WORK/last.out" 2>/dev/null)"
  if sdkharness_tf_trouble_is_proxy_refusal "$txt"; then
    fail "$1" "a non-loopback connection was attempted and refused by the network guard"
  fi
  # Only the loopback simulator is ever contacted, with its fixed credential, so a
  # rejected credential, a refused or reset connection or a timeout is the
  # simulator or the provider misbehaving (an auth, hang or crash regression),
  # never a legitimate environment problem: FAIL, not COULD-NOT-RUN.
  case "$txt" in
    *unauthorized*|*bad_auth_token*|*invalidauthtoken*|*expired_auth_token*|*"invalid authorization token"*|*not_authorized*|*"not authorized"*|*access_denied*|*accessdenied*|*"access denied"*|*forbidden*|*restrictedbucket*|*"invalid application key"*|*"bad auth token"*|*" 401"*|*" 403"*)
      fail "$1" "authorization failed against the simulator: $(first_error "$WORK/last.out")" ;;
    *"no such host"*|*"could not resolve"*|*"connection refused"*|*"network is unreachable"*|*"i/o timeout"*|*"timed out"*|*"dial tcp"*|*"name resolution"*|*"name or service not known"*|*"nodename nor servname"*|*gaierror*|*b2connectionerror*|*connectionerror*|*"max retries exceeded"*|*"failed to establish a new connection"*|*"connection aborted"*|*"connection reset"*|*b2requesttimeout*|*"failed to query available provider packages"*|*"could not connect"*|*"no route to host"*|*unknownhost*)
      fail "$1" "the simulator did not answer (unreachable, reset or timed out): $(first_error "$WORK/last.out")" ;;
  esac
  fail "$1" "$(first_error "$WORK/last.out")"
}

tfout()  { terraform -chdir="$WORK" output -raw "$1" 2>/dev/null; }
assert() { # <output> <step> <detail>
  [ "$(tfout "$1")" = "true" ] && return 0
  fail "$2" "$3"
}

# --- 1. which realm ---------------------------------------------------------
# Only the loopback simulator is allowed: no staging or production mode and no
# ambient credential. Run the dispatcher (run-conformance), which supplies the
# validated simulator URL and the exact-revision provider directory.
. "$(dirname "$0")/../lib/terraform-provider.sh"
[ "$TARGET" = simulator ] || fail configuration "only the loopback simulator is allowed, not '$TARGET'"
[ -n "${CONFORMANCE_SIMULATOR_URL:-}" ] \
  || fail configuration "CONFORMANCE_SIMULATOR_URL is unset"
sdkharness_valid_loopback_origin "$CONFORMANCE_SIMULATOR_URL" \
  || fail configuration "CONFORMANCE_SIMULATOR_URL must be a bare IPv4 loopback HTTP origin"
ENDPOINT="$CONFORMANCE_SIMULATOR_URL"
sdkharness_drop_ambient_b2_env
# The simulator's fixed test credential, so a real B2_* value can never be sent there.
export B2_APPLICATION_KEY_ID="test-key-id" B2_APPLICATION_KEY="test-key"
sdkharness_tf_network_guard

# --- 2. a credential the provider can actually read -------------------------
if [ -z "${B2_APPLICATION_KEY_ID:-}" ] && [ -z "${B2_APPLICATION_KEY:-}" ] && [ -z "${B2_TEST_APPLICATION_KEY_ID:-}" ]; then
  fail configuration "B2_APPLICATION_KEY_ID / B2_APPLICATION_KEY unset"
fi
if [ -z "${B2_APPLICATION_KEY_ID:-}" ] || [ -z "${B2_APPLICATION_KEY:-}" ]; then
  fail configuration "the provider authorizes from B2_APPLICATION_KEY_ID + B2_APPLICATION_KEY; only one of the pair is set"
fi

# --- 3. runtimes ------------------------------------------------------------
need terraform || amber missing-runtime "terraform is not on PATH"

# --- 4. a scratch working directory this check owns -------------------------
WORK="$(mktemp -d "${TMPDIR:-/tmp}/sdkharness-conf-tf-lifecycle.XXXXXX")" \
  || fail setup "could not create a scratch working directory"

export TF_INPUT=0 TF_IN_AUTOMATION=1 CHECKPOINT_DISABLE=1
unset TF_LOG TF_LOG_PATH TF_LOG_CORE TF_LOG_PROVIDER
if ! sdkharness_tf_cli_config "$WORK/cli.tfrc"; then
  # The provider BUILD is missing: the only other environment gap (beside terraform
  # itself) that is COULD-NOT-RUN rather than FAIL.
  amber missing-runtime "the exact-revision provider build (terraform-provider-b2 in SDKHARNESS_TERRAFORM_PROVIDER_DIR) is not available"
fi
export TF_CLI_CONFIG_FILE="$WORK/cli.tfrc"   # exact-revision dev override
export TF_VAR_endpoint="$ENDPOINT"
export TF_VAR_bucket_name="sdkharness-conf-$(rand_hex)"
export TF_VAR_stage=1

cat >"$WORK/main.tf" <<'HCL'
terraform {
  required_version = ">= 1.0.0"
  required_providers {
    b2 = {
      source = "Backblaze/b2"
    }
  }
}

# No credential is ever written here. The provider reads
# B2_APPLICATION_KEY_ID / B2_APPLICATION_KEY from the environment; only the
# realm is declared, through the endpoint attribute the card documents.
provider "b2" {
  endpoint = var.endpoint
}

variable "endpoint" { type = string }
variable "bucket_name" { type = string }
variable "stage" { type = number }

resource "b2_bucket" "b" {
  bucket_name = var.bucket_name
  bucket_type = "allPrivate"

  lifecycle_rules {
    file_name_prefix             = "st/"
    days_from_hiding_to_deleting = 1
  }
}

data "b2_bucket" "read" {
  count       = var.stage == 1 ? 1 : 0
  bucket_name = b2_bucket.b.bucket_name
}

locals {
  rules = try(data.b2_bucket.read[0].lifecycle_rules, [])
  rule  = try(local.rules[0], null)
}

output "ok_one_rule" { value = length(local.rules) == 1 }
output "ok_prefix" { value = try(local.rule.file_name_prefix, "") == "st/" }
output "ok_hiding_to_deleting" { value = try(local.rule.days_from_hiding_to_deleting, -1) == 1 }
HCL

# --- 5. check our config against the exact-revision provider -----------------
# No `terraform init`: dev_overrides needs no installation, and init would contact the
# provider registry (and fall back to the published release) -- network the assertions
# must not use.
tf validate -no-color \
  || fail "terraform validate" "the configuration does not match the installed provider schema: $(first_error "$WORK/last.out")"

# --- 6. the customer path ---------------------------------------------------
APPLIED=1
tf apply -auto-approve -input=false -no-color || tf_trouble "terraform apply (bucket with a lifecycle rule)"

assert ok_one_rule           "read back" "the bucket does not read back exactly one lifecycle rule"
assert ok_prefix             "read back" "file_name_prefix did not round-trip"
assert ok_hiding_to_deleting "read back" "days_from_hiding_to_deleting did not round-trip as 1"

tf plan -input=false -no-color -detailed-exitcode
drift=$?
case "$drift" in
  0) : ;;
  2) fail "read back" "terraform plan reports lifecycle drift immediately after apply" ;;
  *) tf_trouble "terraform plan (post-apply read-back)" ;;
esac

pass
