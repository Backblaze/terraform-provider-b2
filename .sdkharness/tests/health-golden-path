#!/usr/bin/env bash
# Repository-owned customer-health lifecycle for terraform-provider-b2.
# The harness supplies a throwaway bucket and loopback B2 simulator. The provider under test is
# either the directory in SDKHARNESS_TERRAFORM_PROVIDER_DIR (no build, no network), or a build of
# a scratch COPY of this checkout made by the PREPARE step below. The checkout itself is never
# written to, whatever the working directory is.
set -u

LEVEL=health
SCENARIO=golden-path
# The checkout is located from this file, not from the working directory, so a direct run from
# any directory (including the checkout) can never build inside the tree under test.
REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd -P)"
WORK=""
VERIFY=""
BUILD_LOG=""
BUILD_SCRATCH=""
DESTROY_NEEDED=0
VERDICT=FAIL
DETAIL='setup: test ended without a verdict'

emit() {
  printf 'SDKHARNESS_RESULT\t%s\t%s\t%s\t%s\n' "$LEVEL" "$SCENARIO" "$VERDICT" "$DETAIL"
}

cleanup() {
  local status=$?
  if [ "$DESTROY_NEEDED" = 1 ] && [ -n "$WORK" ]; then
    if ! terraform -chdir="$WORK" destroy -auto-approve -input=false -no-color \
      -var "bucket_name=$B2_BUCKET_NAME" -var "object_name=$OBJECT_NAME" \
      >"$WORK/destroy.log" 2>&1; then
      VERDICT=FAIL
      DETAIL='destroy: Terraform left the health-check object behind'
      status=1
    fi
  fi
  [ -z "$WORK" ] || rm -rf "$WORK"
  [ -z "$VERIFY" ] || rm -rf "$VERIFY"
  [ -z "$BUILD_LOG" ] || rm -f "$BUILD_LOG"
  [ -z "$BUILD_SCRATCH" ] || rm -rf "$BUILD_SCRATCH"
  emit
  exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

fail() {
  VERDICT=FAIL
  DETAIL="$1: $2"
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || fail setup "$1 is not installed"
}

[ "${SDKHARNESS_TEST_LEVEL:-}" = "$LEVEL" ] || fail configuration 'unexpected test level'
[ "${SDKHARNESS_SCENARIO:-}" = "$SCENARIO" ] || fail configuration 'unexpected scenario'
[ -n "${SDKHARNESS_SIMULATOR_URL:-}" ] || fail configuration 'simulator URL is unset'
[ -n "${B2_APPLICATION_KEY_ID:-}" ] || fail configuration 'application key ID is unset'
[ -n "${B2_APPLICATION_KEY:-}" ] || fail configuration 'application key is unset'
[ -n "${B2_BUCKET_NAME:-}" ] || fail configuration 'throwaway bucket is unset'
# Only the simulator's fixed test credential is accepted, so running this file directly cannot
# send a real key anywhere.
[ "$B2_APPLICATION_KEY_ID" = test-key-id ] && [ "$B2_APPLICATION_KEY" = test-key ] \
  || fail configuration "only the simulator's fixed test credential is accepted"

need terraform
need go
need make
need python3
need jq

python3 -c '
import sys
from urllib.parse import urlsplit
url = urlsplit(sys.argv[1])
valid = (url.scheme == "http" and url.hostname == "127.0.0.1" and url.port is not None
         and url.username is None and url.password is None and url.path in ("", "/")
         and not url.query and not url.fragment)
raise SystemExit(0 if valid else 1)
' "$SDKHARNESS_SIMULATOR_URL" \
  || fail configuration 'simulator URL must be a bare IPv4 loopback HTTP origin'

# PREPARE: obtain the provider executable. A caller that already holds the exact-revision provider
# passes it in SDKHARNESS_TERRAFORM_PROVIDER_DIR and nothing is built (the fully offline path; use
# it for direct runs). Otherwise the provider is built from a writable scratch COPY of this
# checkout, never in the checkout: `make build` may download Go modules and Python packages, which
# is why it is a separate step that runs BEFORE any assertion and before the network guard below
# is installed. Nothing in the assertion phase (terraform apply/destroy) uses that network.
PROVIDER_DIR="${SDKHARNESS_TERRAFORM_PROVIDER_DIR:-}"
if [ -z "$PROVIDER_DIR" ]; then
  BUILD_SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/sdkharness-tf-provider-build.XXXXXX")" \
    || fail setup 'could not create the provider build directory'
  BUILD_LOG="$BUILD_SCRATCH/build.log"
  cp -R "$REPO_ROOT/." "$BUILD_SCRATCH/repository" 2>/dev/null \
    || fail setup 'could not copy the checkout for the provider build'
  chmod -R u+w "$BUILD_SCRATCH/repository" \
    || fail setup 'the provider build copy could not be made writable'
  # STATICX=0: the Makefile's staticx step (Linux) rejects the CI interpreter and only matters
  # for shipping the binding. A command-line assignment also beats an ambient STATICX=1.
  if ! (cd "$BUILD_SCRATCH/repository" && CHECKPOINT_DISABLE=1 make build STATICX=0) >"$BUILD_LOG" 2>&1; then
    fail build 'make build failed for a copy of this checkout'
  fi
  PROVIDER_DIR="$BUILD_SCRATCH/repository"
fi
[ -x "$PROVIDER_DIR/terraform-provider-b2" ] \
  || fail build 'terraform-provider-b2 executable is absent'
PROVIDER_HCL="$(python3 -c 'import json, sys; print(json.dumps(sys.argv[1]))' "$PROVIDER_DIR")" \
  || fail configuration 'provider directory could not be encoded'

WORK="$(mktemp -d "${TMPDIR:-/tmp}/sdkharness-tf-health.XXXXXX")" \
  || fail setup 'could not create the Terraform workspace'
VERIFY="$(mktemp -d "${TMPDIR:-/tmp}/sdkharness-tf-health-verify.XXXXXX")" \
  || fail setup 'could not create the verification workspace'

cat >"$WORK/cli.tfrc" <<EOF
provider_installation {
  dev_overrides {
    "Backblaze/b2" = $PROVIDER_HCL
  }
}
EOF
export TF_CLI_CONFIG_FILE="$WORK/cli.tfrc"
export TF_INPUT=0 TF_IN_AUTOMATION=1 CHECKPOINT_DISABLE=1
# Only the loopback simulator may be reached: every proxy-aware client gets a dead proxy, loopback is exempt.
export HTTP_PROXY=http://127.0.0.1:1 HTTPS_PROXY=http://127.0.0.1:1 ALL_PROXY=http://127.0.0.1:1
export http_proxy=http://127.0.0.1:1 https_proxy=http://127.0.0.1:1 all_proxy=http://127.0.0.1:1
export NO_PROXY=127.0.0.1,localhost,::1 no_proxy=127.0.0.1,localhost,::1
unset TF_LOG TF_LOG_PATH TF_LOG_CORE TF_LOG_PROVIDER
export TF_VAR_endpoint="$SDKHARNESS_SIMULATOR_URL"

OBJECT_NAME="sdkharness-health/$(date +%s)-$RANDOM.txt"
printf 'terraform-provider-b2 repository health %s\n' "$OBJECT_NAME" >"$WORK/payload.txt" \
  || fail setup 'could not create the payload'
if command -v shasum >/dev/null 2>&1; then
  EXPECTED_SHA1="$(shasum -a 1 "$WORK/payload.txt" | awk '{print $1}')"
else
  EXPECTED_SHA1="$(sha1sum "$WORK/payload.txt" | awk '{print $1}')"
fi

cat >"$WORK/main.tf" <<'EOF'
terraform {
  required_providers {
    b2 = { source = "Backblaze/b2" }
  }
}
provider "b2" { endpoint = var.endpoint }
variable "endpoint" { type = string }
variable "bucket_name" { type = string }
variable "object_name" { type = string }
data "b2_bucket" "existing" { bucket_name = var.bucket_name }
resource "b2_bucket_file_version" "health" {
  bucket_id = data.b2_bucket.existing.bucket_id
  file_name = var.object_name
  source    = "${path.module}/payload.txt"
}
data "b2_bucket_file" "verify" {
  bucket_id  = data.b2_bucket.existing.bucket_id
  file_name  = var.object_name
  depends_on = [b2_bucket_file_version.health]
}
output "versions" { value = data.b2_bucket_file.verify.file_versions }
EOF

# No `terraform init`: dev_overrides needs no installation, and init would contact the provider
# registry -- network this check must not use.
DESTROY_NEEDED=1
if ! terraform -chdir="$WORK" apply -auto-approve -input=false -no-color \
  -var "bucket_name=$B2_BUCKET_NAME" -var "object_name=$OBJECT_NAME" \
  >"$WORK/apply.log" 2>&1; then
  fail apply 'Terraform could not create the health-check object'
fi

VERSIONS="$(terraform -chdir="$WORK" output -json versions 2>/dev/null)" \
  || fail verify 'Terraform did not return the independent file read'
COUNT="$(printf '%s' "$VERSIONS" | jq 'length' 2>/dev/null)" \
  || fail verify 'the independent file read was not JSON'
[ "$COUNT" -ge 1 ] 2>/dev/null || fail verify 'the object was not listed after apply'
ACTUAL_SHA1="$(printf '%s' "$VERSIONS" | jq -r '.[0].content_sha1' 2>/dev/null)"
[ "$ACTUAL_SHA1" = "$EXPECTED_SHA1" ] \
  || fail verify 'the listed object checksum differs from the uploaded payload'

if ! terraform -chdir="$WORK" destroy -auto-approve -input=false -no-color \
  -var "bucket_name=$B2_BUCKET_NAME" -var "object_name=$OBJECT_NAME" \
  >"$WORK/destroy.log" 2>&1; then
  fail destroy 'Terraform could not remove the health-check object'
fi
DESTROY_NEEDED=0

cp "$WORK/cli.tfrc" "$VERIFY/cli.tfrc"
cp "$WORK/.terraform.lock.hcl" "$VERIFY/.terraform.lock.hcl" 2>/dev/null || true
cat >"$VERIFY/main.tf" <<'EOF'
terraform {
  required_providers {
    b2 = { source = "Backblaze/b2" }
  }
}
provider "b2" { endpoint = var.endpoint }
variable "endpoint" { type = string }
variable "bucket_name" { type = string }
variable "object_name" { type = string }
data "b2_bucket" "existing" { bucket_name = var.bucket_name }
data "b2_bucket_file" "verify" {
  bucket_id = data.b2_bucket.existing.bucket_id
  file_name = var.object_name
}
output "versions" { value = data.b2_bucket_file.verify.file_versions }
EOF
export TF_CLI_CONFIG_FILE="$VERIFY/cli.tfrc"
if terraform -chdir="$VERIFY" apply -auto-approve -input=false -no-color \
  -var "bucket_name=$B2_BUCKET_NAME" -var "object_name=$OBJECT_NAME" \
  >"$VERIFY/apply.log" 2>&1; then
  GONE="$(terraform -chdir="$VERIFY" output -json versions 2>/dev/null)" \
    || fail verify 'post-delete output was unavailable'
  GONE_COUNT="$(printf '%s' "$GONE" | jq 'length' 2>/dev/null)" \
    || fail verify 'post-delete output was not JSON'
  [ "$GONE_COUNT" = 0 ] || fail verify 'the deleted object is still listed'
elif ! grep -qiE 'not[_ ]?found|no such file|does not exist|404' "$VERIFY/apply.log"; then
  fail verify 'the post-delete read failed for a reason other than not-found'
fi

VERDICT=PASS
DETAIL=-
exit 0
